{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // ビルドせず、利用側（wrangler）がソースをそのままバンドルする
    "noEmit": true
  },
  "include": ["src", "scripts"]
}
