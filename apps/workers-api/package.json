{
  "name": "@urekoi/workers-api",
  "type": "module",
  "types": "./src/index.tsx",
  "scripts": {
    "dev": "wrangler dev",
    "mailpit": "pnpm --filter @urekoi/email mailpit",
    "typecheck": "tsc",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:push:test": "drizzle-kit push --config drizzle.test.config.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:test": "DOTENV_CONFIG_PATH=.env.test DOTENV_OVERRIDE=true pnpm tsx src/db/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@better-auth/i18n": "^1.7.5",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@scalar/hono-api-reference": "^0.12.14",
    "@urekoi/core": "workspace:*",
    "@urekoi/email": "workspace:^",
    "@urekoi/logger": "workspace:^",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.8",
    "@types/node": "^26.4.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
