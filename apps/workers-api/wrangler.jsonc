{
  "name": "urekoi2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  // nodemailer（ローカルの Mailpit への送信）が Node の net / tls などを使うため
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [{ "name": "EMAIL" }],
  "routes": [{ "pattern": "api.urekoi.com", "custom_domain": true }],
  // 本番用の環境変数（シークレットは wrangler secret で設定する）
  "vars": {
    "WEB_URL": "https://urekoi.com",
    "BETTER_AUTH_URL": "https://api.urekoi.com",
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM": "熟恋 <no-reply@urekoi.com>"
  },
  "observability": {
    "enabled": true
  },
  "previews": {},
  // 他プロジェクトと被らないようポート固定
  "dev": {
    "ip": "0.0.0.0",
    "port": 8800
  }
}
