    "cn": "^0.5.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.88.0",
